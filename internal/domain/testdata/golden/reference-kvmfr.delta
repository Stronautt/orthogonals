-    <shmem name='looking-glass'>
-      <model type='ivshmem-plain'/>
-      <size unit='M'>128</size>
-    </shmem>
+    <!-- A controller's index is its PCI bus number and libvirt emits -device in
+         index order, so the bridge's root port is declared here with the lower
+         index: left to libvirt the bridge lands on an auto-added port above it
+         and qemu fails the start with "Bus 'pci.2' not found". -->
+    <controller type='pci' index='1' model='pcie-root-port'/>
+    <controller type='pci' index='2' model='pcie-to-pci-bridge'>
+      <address type='pci' domain='0x0000' bus='0x01' slot='0x00' function='0x0'/>
+    </controller>
+    <qemu:arg value='-object'/>
+    <qemu:arg value='{"qom-type":"memory-backend-file","id":"looking-glass","mem-path":"/dev/kvmfr0","size":134217728,"share":true}'/>
+    <qemu:arg value='-device'/>
+    <qemu:arg value='{"driver":"ivshmem-plain","id":"shmem0","memdev":"looking-glass","bus":"pci.2","addr":"0x1"}'/>
